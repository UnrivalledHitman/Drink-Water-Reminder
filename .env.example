# Copy to .env.local and fill in. These are public keys/IDs built into the app.

# RevenueCat → Project settings → API keys (public SDK keys)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# AdMob → Apps → your app → Ad units → banner ad unit ID (release builds only;
# development builds always show Google's test ads)
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=

# Required by the app stores for subscriptions
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
